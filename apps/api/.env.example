# Copy to `.env` for local overrides (`.env` is gitignored). Placeholders only: never commit real values.
# Every variable is optional in development; the defaults below are used when it is unset or empty.

# development | test | production
NODE_ENV=development

# Bind address and port. Keep 127.0.0.1 unless a reverse proxy in front needs otherwise.
HOST=127.0.0.1
PORT=3001

# Comma-separated allow-list of browser origins for the CSRF Origin check on POST/PUT/PATCH/DELETE.
# Exact origins only (scheme://host[:port], no path, no trailing slash, no wildcards).
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to true only behind a trusted reverse proxy; it makes the client IP (rate limiting) come from
# X-Forwarded-For. Leave false otherwise or clients can spoof their IP.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent. Default: info (silent when NODE_ENV=test).
# LOG_LEVEL=info

# SQLite file path, or ":memory:". Relative paths resolve against the process working directory
# (apps/api when run via the npm scripts). The directory is created if missing. `data/` is gitignored.
# DATABASE_PATH=data/site.db

# --- Planned, NOT read yet (added by later backend tasks) ---
# OPERATOR_USERNAME=[PLACEHOLDER: operator username]
# OPERATOR_PASSWORD_HASH=[PLACEHOLDER: output of the hash-password script, never a plain password]
