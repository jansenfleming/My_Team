{
  "name": "@site/qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent tests, tools, and reports (see docs/architecture/board.md, tasks Q1-Q6).",
  "scripts": {
    "test": "node --test \"tools/*.test.mjs\" && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "scan:secrets": "node tools/scan-secrets.mjs",
    "scan:secrets:history": "node tools/scan-secrets.mjs --history"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
