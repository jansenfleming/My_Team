{
  "name": "my-team-site",
  "version": "0.0.0",
  "private": true,
  "description": "Cyberpunk / cybersecurity personal website built by a five-agent team (npm workspaces monorepo).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "qa"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta \"npm run dev -w @site/api\" \"npm run dev -w @site/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "audit:ci": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "concurrently": "^10.0.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
