{
  "name": "zerojance-site",
  "version": "0.0.0",
  "private": true,
  "description": "ZeroJance streetwear catalog/lookbook mockup (npm workspaces monorepo).",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "npm run dev -w @site/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test tools/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "scan-secrets": "node tools/scan-secrets.mjs",
    "audit:ci": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
